# HypDMZ — copy to <state dir>/.env (Windows: %USERPROFILE%\.hypdmz\.env; `hypdmz doctor` prints the path).
# Nothing here is read from the repo.

# The model endpoint the swarm talks to (OpenAI-compatible) and the default model id.
MODEL_BASE_URL=https://api.deepinfra.com/v1/openai
MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# The API key. Preferred: a podman secret, which reaches the proxy container alone, as a file, never in any
# environment or `podman inspect`:
#     podman secret create hypdmz_llm_api_key -        (then paste the key, Enter, Ctrl-D / Ctrl-Z)
# Fallback: set it here; on the next `hypdmz up` the proxy stores it in its vault (AES-256-GCM, master key in
# proxy-data/) — then delete the line. Either way the swarm only ever sees a placeholder.
#HYPDMZ_KEY_SECRET=hypdmz_llm_api_key
MODEL_API_KEY=

# Host ports (loopback only). Change these if something else holds them.
HYPDMZ_UI_PORT=8000
HYPDMZ_CONSOLE_PORT=8002
HYPDMZ_PROXY_PORT=8080

# Where swarm records land (default <state dir>/records).
#HYPDMZ_RECORDS_DIR=

# Hardening knobs (defaults are the safe ones).
#DLP_MODE=block            # block | log — secrets found in an outbound body/header
#AUDIT_SINK_URL=           # every audit event is also POSTed here as JSON
#AUDIT_SINK_TOKEN=
